# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of this app (used in magic-link redirects and webhook payload links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string

# 32 bytes, base64-encoded. Encrypts connector credentials (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Temporary open access: "true" replaces email sign-in with one "Sign in" button that
# logs everyone into the same shared account. Anyone with the URL gets full access.
# Leave unset/false for normal magic-link sign-in.
OPEN_LOGIN=false
